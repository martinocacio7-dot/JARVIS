# Copia este archivo a .env y añade tu clave de API. Nunca la subas a Git.
JARVIS_API_KEY=
JARVIS_MODEL=gpt-4.1-mini
PORT=3000
HOST=0.0.0.0
# Obligatorio en producción. Configúralo en el alojamiento, nunca en GitHub.
JARVIS_USER=jarvis
JARVIS_PASSWORD=
# PostgreSQL para la biblioteca en producción. Configurar solo en Render.
DATABASE_URL=
# SQLite solo para desarrollo local con Node.js 24.
JARVIS_DATABASE_PATH=./data/jarvis.sqlite
# Voz personalizada opcional. Guarda la clave real solo en Render.
ELEVENLABS_API_KEY=
# Opcional: voz ya creada en tu cuenta si no usas la creación desde JARVIS.
ELEVENLABS_VOICE_ID=
